SELECT
  EMPLOYEE_ID,
  FIRST_NAME,
  SALARY,
  DEPARTMENT_ID,
  CASE
    WHEN SALARY < 10000 THEN
      'SALARY < 10000'
    WHEN SALARY >= 10000 AND SALARY <= 20000 THEN
      'SALARY between 10000 and 20000'
    ELSE
      'SALARY > 20000'
  END           AS SALARY_RANGE, DEPARTMENT_ID
FROM
  HR.EMPLOYEES
WHERE
  DEPARTMENT_ID = 100;