60b81696-7431-4c93-86a3-c4629c53620a:1707734241678:79:S:SELECT\n  EMPLOYEE_ID,\n  FIRST_NAME,\n  SALARY,\n  DEPARTMENT_ID,\n  CASE\n    WHEN SALARY < 10000 THEN\n      'SALARY < 10000'\n    WHEN SALARY >= 10000 AND SALARY <= 20000 THEN\n      'SALARY between 10000 and 20000'\n    ELSE\n      'SALARY > 20000'\n  END           AS SALARY_RANGE, DEPARTMENT_ID\nFROM\n  HR.EMPLOYEES\nWHERE\n  DEPARTMENT_ID = 100;
